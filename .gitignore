# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# visual-check screenshots (regenerate with `npm run check:visual`)
/.visual-check/

# Original brand artwork the build copies from. Kept out of the repo so the
# source-of-truth files stay in OneDrive rather than being forked into git —
# everything the site actually serves lives in /public/assets.
/source-assets/
